diff --git a/rosidl_generator_type_description/cmake/rosidl_generator_type_description_generate_interfaces.cmake b/rosidl_generator_type_description/cmake/rosidl_generator_type_description_generate_interfaces.cmake
index ed29cda..b198431 100644
--- a/rosidl_generator_type_description/cmake/rosidl_generator_type_description_generate_interfaces.cmake
+++ b/rosidl_generator_type_description/cmake/rosidl_generator_type_description_generate_interfaces.cmake
@@ -93,6 +93,17 @@ add_custom_command(
 set(_target "${rosidl_generate_interfaces_TARGET}__rosidl_generator_type_description")
 add_custom_target(${_target} DEPENDS ${_generated_files})
 
+# This generator reads the type-hash JSON files of dependency packages (via
+# INCLUDE_PATHS). In a single-tree standalone build those packages are sibling
+# subdirectories, so add an explicit build-graph dependency on their
+# type-description targets to avoid a parallel-build race where a dependency's
+# JSON has not been generated yet.
+foreach(_pkg_name ${rosidl_generate_interfaces_DEPENDENCY_PACKAGE_NAMES})
+  if(TARGET ${_pkg_name}__rosidl_generator_type_description)
+    add_dependencies(${_target} ${_pkg_name}__rosidl_generator_type_description)
+  endif()
+endforeach()
+
 # Make top level generation target depend on this generated library
 add_dependencies(${rosidl_generate_interfaces_TARGET} ${_target})
 
